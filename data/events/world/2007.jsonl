{"id":"world-2007-dotnet35","known":"2007-11-19","occurred":"2007-11-19","kind":"tech","stage":"effective","title":".NET Framework 3.5 ships with Visual Studio 2008","impact":"LINQ, LINQ to SQL and System.Xml.Linq arrive; Visual Studio 2008 can also target 2.0 and 3.0, so teams can upgrade the IDE first","industries":["*"],"areas":["platform"],"tech":{"product":"dotnet-framework","version":"3.5","markers":[{"lang":"cs","name":"System.Linq","pattern":"\\bSystem\\.(Data\\.)?Linq\\b"},{"lang":"vb","name":"System.Linq","pattern":"\\bSystem\\.(Data\\.)?Linq\\b"},{"lang":"cs","name":"System.Xml.Linq","pattern":"\\bSystem\\.Xml\\.Linq\\b|\\bXDocument\\b|\\bXElement\\b"},{"lang":"vb","name":"System.Xml.Linq","pattern":"\\bSystem\\.Xml\\.Linq\\b|\\bXDocument\\b|\\bXElement\\b"},{"lang":"cs","name":"HashSet","pattern":"\\bHashSet<"},{"lang":"vb","name":"HashSet","pattern":"\\bHashSet\\(\\s*Of\\b"},{"lang":"cs","name":"TimeZoneInfo","pattern":"\\bTimeZoneInfo\\b"},{"lang":"vb","name":"TimeZoneInfo","pattern":"\\bTimeZoneInfo\\b"}]},"sources":["https://visualstudiomagazine.com/articles/2007/11/19/microsoft-releases-visual-studio-2008.aspx","https://devblogs.microsoft.com/somasegar/visual-studio-2008-and-net-framework-3-5-shipped/","https://learn.microsoft.com/en-us/dotnet/framework/install/versions-and-dependencies","https://learn.microsoft.com/en-us/dotnet/api/system.data.linq.datacontext","https://learn.microsoft.com/en-us/dotnet/api/system.xml.linq.xdocument","https://learn.microsoft.com/en-us/lifecycle/products/microsoft-net-framework","https://learn.microsoft.com/en-us/dotnet/api/system.collections.generic.hashset-1","https://learn.microsoft.com/en-us/dotnet/api/system.timezoneinfo","https://learn.microsoft.com/en-us/previous-versions/visualstudio/visual-studio-2008/bb398197(v=vs.90)"],"status":"verified","verified":{"on":"2026-10-30","by":"claude-code-cloud-verify-2"}}
{"id":"world-2007-csharp3","known":"2007-11-19","occurred":"2007-11-19","kind":"tech","stage":"effective","title":"C# 3.0 ships with Visual Studio 2008","impact":"var, lambdas, LINQ queries, extension methods and auto-properties become available, but only to teams on Visual Studio 2008 or later","industries":["*"],"areas":["platform"],"tech":{"product":"csharp","version":"3.0","markers":[{"lang":"cs","name":"implicitly typed locals (var)","pattern":"\\bvar\\s+\\w+\\s*="},{"lang":"cs","name":"lambda expressions","pattern":"(\\b\\w+|\\))\\s*=>"},{"lang":"cs","name":"LINQ query syntax","pattern":"\\bfrom\\s+\\w+\\s+in\\s+\\w"},{"lang":"cs","name":"extension methods","pattern":"\\(\\s*this\\s+\\w"},{"lang":"cs","name":"auto-implemented properties","pattern":"\\{\\s*get;\\s*((private|protected|internal)\\s+)?set;\\s*\\}"},{"lang":"cs","name":"object initializers","pattern":"\\bnew\\s+[\\w.]+(\\s*\\(\\s*\\))?\\s*\\{\\s*\\w+\\s*="},{"lang":"cs","name":"anonymous types","pattern":"\\bnew\\s*\\{"}]},"sources":["https://visualstudiomagazine.com/articles/2007/11/19/microsoft-releases-visual-studio-2008.aspx","https://learn.microsoft.com/en-us/dotnet/csharp/whats-new/csharp-version-history","https://devblogs.microsoft.com/somasegar/visual-studio-2008-and-net-framework-3-5-shipped/"],"status":"verified","verified":{"on":"2026-10-30","by":"claude-code-cloud-verify-2"}}
{"id":"world-2007-vbnet9","known":"2007-11-19","occurred":"2007-11-19","kind":"tech","stage":"effective","title":"Visual Basic 2008 (VB 9.0) ships with Visual Studio 2008","impact":"LINQ queries, the If operator, local type inference, lambdas and XML literals become available, but only to teams on Visual Studio 2008 or later","industries":["*"],"areas":["platform"],"tech":{"product":"vbnet","version":"9.0","markers":[{"lang":"vb","name":"LINQ query syntax","pattern":"\\bFrom\\s+\\w+\\s+In\\s+\\w"},{"lang":"vb","name":"If operator","pattern":"[=(,]\\s*If\\s*\\("},{"lang":"vb","name":"Option Infer statement (local type inference)","pattern":"(?im)^\\s*Option\\s+Infer\\s+(On|Off)\\b"},{"lang":"vb","name":"lambda expressions","pattern":"\\bFunction\\s*\\("},{"lang":"vb","name":"object initializers","pattern":"\\bNew\\s+[\\w.]+(\\s*\\(\\s*\\))?\\s+With\\s*\\{"},{"lang":"vb","name":"anonymous types","pattern":"\\bNew\\s+With\\s*\\{"},{"lang":"vb","name":"extension methods","pattern":"<(System\\.Runtime\\.CompilerServices\\.)?Extension(\\(\\))?>"},{"lang":"vb","name":"nullable shorthand","pattern":"\\bAs\\s+(Integer|Long|Short|Byte|Decimal|Double|Single|Boolean|Date|DateTime)\\?"},{"lang":"vb","name":"XML literals","pattern":"=\\s*<(\\?xml|[A-Za-z][\\w:.-]*[\\s/>])"}]},"sources":["https://visualstudiomagazine.com/articles/2007/11/19/microsoft-releases-visual-studio-2008.aspx","https://learn.microsoft.com/en-us/dotnet/visual-basic/whats-new/","https://devblogs.microsoft.com/somasegar/visual-studio-2008-and-net-framework-3-5-shipped/","https://learn.microsoft.com/en-us/previous-versions/visualstudio/visual-studio-2008/ms234437(v=vs.90)"],"status":"verified","verified":{"on":"2026-10-30","by":"claude-code-cloud-verify-2"}}
